# ── SafeSpace AI · Environment Configuration Template ─────────────────────────
# Copy this file to '.env' for local development or set these variables in Render / Cloud dashboard.

# Supabase PostgreSQL connection string (Transaction pooler on port 6543 recommended)
DATABASE_URL=postgresql://postgres.your_project_id:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# Cloud AI API Keys (At least one key is recommended for fast sub-second replies)
# OpenRouter (Recommended: free fast models like gemma-4, nemotron)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# Google Gemini API Key
GEMINI_API_KEY=AIzaSy_your_gemini_key

# Groq Cloud API Key
GROQ_API_KEY=gsk_your_groq_key

# Secret key for signing JSON Web Tokens (JWT)
JWT_SECRET=your_secure_random_jwt_secret_here

# Local Ollama daemon (Optional, used if running local LLMs)
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=alibayram/medgemma:4b

# Server Port (Render sets this automatically)
PORT=8000
